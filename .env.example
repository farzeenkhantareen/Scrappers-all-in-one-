# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=change-me-in-production-use-random-32-char-string

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero-config for development)
DATABASE_URL=sqlite+aiosqlite:///./scrappers.db

# PostgreSQL (for production, uncomment below)
# DATABASE_URL=postgresql+asyncpg://scrappers:scrappers_secret@localhost:5432/scrappers

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000"]

# ─── Scraping Defaults ────────────────────────────────────────────────────────
DEFAULT_MAX_PAGES=100
DEFAULT_MAX_DEPTH=5
DEFAULT_CONCURRENCY=5
DEFAULT_DELAY_MS=1000
DEFAULT_TIMEOUT_SEC=30
DEFAULT_MAX_RETRIES=3
HEADLESS_BROWSER=true

# ─── Storage ──────────────────────────────────────────────────────────────────
MEDIA_DIR=./media
EXPORT_DIR=./exports

# ─── Proxy (optional) ─────────────────────────────────────────────────────────
# PROXY_URL=http://proxy-host:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ─── Platform Credentials (optional, improves success rate) ───────────────────
# INSTAGRAM_USERNAME=your_username
# INSTAGRAM_PASSWORD=your_password
# LINKEDIN_USERNAME=your@email.com
# LINKEDIN_PASSWORD=your_password
